<title>Viagem para Prudentópolis</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#f2f6f4;color:#263832;line-height:1.7}
header{background:linear-gradient(135deg,#244b35,#5b9561);color:white;text-align:center;padding:65px 20px}
header h1{font-size:clamp(30px,5vw,46px);margin-bottom:12px}
nav{background:white;padding:16px;text-align:center;position:sticky;top:0}
nav a{color:#397447;text-decoration:none;font-weight:bold;margin:0 12px}
main{max-width:1000px;margin:auto;padding:25px 18px}
section{background:white;padding:25px;border-radius:14px;margin-bottom:25px;scroll-margin-top:75px}
